{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/api/render?slug=index" },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/api/render?slug=:slug" }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-store" }] }
  ],
  "functions": {
    "api/render.js": { "includeFiles": "{pages/**,404.html}" },
    "api/pages.js": { "includeFiles": "pages/**" }
  }
}
